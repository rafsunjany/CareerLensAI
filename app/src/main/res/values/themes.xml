<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CareerLensAI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- Global Typography: Forces clean Android Roboto sans-serif -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- Material3 Text Appearances -->
        <item name="textAppearanceHeadlineLarge">@style/AppTextAppearance.Headline</item>
        <item name="textAppearanceBodyLarge">@style/AppTextAppearance.Body</item>
        <item name="textAppearanceBodyMedium">@style/AppTextAppearance.Body</item>
        <item name="textAppearanceLabelLarge">@style/AppTextAppearance.Button</item>
    </style>

    <style name="AppTextAppearance.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTextAppearance.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="AppTextAppearance.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>
